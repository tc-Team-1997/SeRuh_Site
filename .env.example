# ─────────────────────────────────────────────────────────────
# SeRuh — build-time configuration
#
# Vite exposes only VITE_-prefixed variables to the browser bundle.
# Everything here ends up in client code, so nothing secret belongs
# in this file. Server-side secrets (the Gemini API key, the Supabase
# service_role key, the database password) live in Supabase Edge
# Function secrets and must never appear here or in any VITE_ name.
# ─────────────────────────────────────────────────────────────

# Google Analytics 4 measurement ID, from GA4 → Admin → Data streams.
# Not a secret — it is visible in any page's network traffic. Leave it
# empty and GA4 stays completely disabled: no script, no events.
VITE_GA_MEASUREMENT_ID=

# Send GA4 events from a non-production build, and set GA4 debug_mode
# so the session shows up in DebugView. Leave unset/false normally —
# this exists so local verification does not require a deploy, and it
# is the only way localhost ever reaches production analytics.
VITE_GA_DEBUG=false
